// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles: REGISTRAR, OWNER, TEACHER
enum UserRole {
  REGISTRAR
  OWNER
  TEACHER
}

// Student class status: new (not assigned), assigned
enum ClassStatus {
  new
  assigned
}

// Payment status: pending, confirmed
enum PaymentStatus {
  pending
  confirmed
}

// Attendance status: present, absent, late
enum AttendanceStatus {
  present
  absent
  late
}

// Academic year status
enum AcademicYearStatus {
  ACTIVE
  CLOSED
}

// Term status
enum TermStatus {
  OPEN
  CLOSED
}

// Promotion status
enum PromotionStatus {
  PROMOTED
  REPEATED
  GRADUATED
}

// User model for authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacherClasses Class[] @relation("HeadTeacher")

  @@index([email])
  @@index([role])
}

// Student model - central entity
model Student {
  id        String        @id @default(uuid())
  
  // Personal details
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  gender          String
  nationality     String?
  religion        String?
  
  // Contact info
  email           String?
  phone           String?
  
  // Parent info
  parentName      String
  parentPhone     String
  parentEmail     String?
  parentRelation  String // e.g., "Father", "Mother", "Guardian"
  
  // Address
  address         String
  city            String
  state           String?
  zipCode         String?
  country         String?
  
  // Emergency contact
  emergencyName   String
  emergencyPhone  String
  emergencyRelation String
  
  // Medical info
  medicalConditions String?
  allergies         String?
  bloodGroup         String?
  
  // Previous school history
  previousSchool     String?
  previousClass      String?
  transferReason     String?
  
  // Status fields
  classStatus     ClassStatus   @default(new)
  paymentStatus   PaymentStatus @default(pending)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  classHistory    StudentClass[]
  attendance      Attendance[]
  marks           Mark[]
  payments        Payment[]

  @@index([classStatus])
  @@index([paymentStatus])
  @@index([firstName, lastName])
}

// Grade model - ordered sequence for grade progression
model Grade {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "Grade 1", "Grade 2"
  order     Int      @unique // Sequential order for progression
  isHighest Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  classes Class[]

  @@index([order])
  @@index([isHighest])
}

// AcademicYear model - explicit academic year entity
model AcademicYear {
  id        String            @id @default(uuid())
  name      String            @unique // e.g., "2024-2025"
  startDate DateTime
  endDate   DateTime?
  status    AcademicYearStatus @default(CLOSED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  classes Class[]
  terms   Term[]

  @@index([status])
  @@index([name])
}

// SystemSettings model - configuration storage
model SystemSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// Class model
model Class {
  id            String   @id @default(uuid())
  name          String   @unique // e.g., "Class A", "Grade 1A"
  description   String?
  academicYearId String?
  gradeId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  headTeacherId String?
  headTeacher   User?   @relation("HeadTeacher", fields: [headTeacherId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  grade        Grade?        @relation(fields: [gradeId], references: [id])
  
  studentClasses StudentClass[]
  subjects       Subject[]
  attendance     Attendance[]
  marks          Mark[]

  @@index([name])
  @@index([academicYearId])
  @@index([gradeId])
}

// Student-Class relationship with history preservation
model StudentClass {
  id             String          @id @default(uuid())
  studentId      String
  classId        String
  startDate      DateTime        @default(now())
  endDate        DateTime?       // NULL means active assignment
  reason         String          // e.g., "initial assignment", "transfer"
  promotionStatus PromotionStatus? // PROMOTED, REPEATED, GRADUATED, or null for active
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([studentId, classId])
  @@index([promotionStatus])
  @@unique([studentId, classId, startDate])
}

// Teacher model (can be extended from User or separate)
model Teacher {
  id        String   @id @default(uuid())
  userId    String?  @unique // Link to User if teacher has account
  name      String
  email     String?
  phone     String?
  subject   String?  // Primary subject
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Subject model - subjects per class
model Subject {
  id          String   @id @default(uuid())
  classId     String
  name        String   // e.g., "Math", "English"
  code        String?  // Subject code
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  marks    Mark[]
  subExams SubExam[]

  @@index([classId])
  @@unique([classId, name])
}

// Term model - academic terms (Term 1, Term 2)
model Term {
  id            String          @id @default(uuid())
  name          String          // "Term 1", "Term 2" (not unique anymore)
  academicYearId String
  startDate     DateTime        @db.Date
  endDate       DateTime?       @db.Date
  status        TermStatus      @default(OPEN)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  academicYear  AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subExams      SubExam[]
  marks         Mark[]

  @@unique([name, academicYearId]) // Term name unique per academic year
  @@index([academicYearId])
  @@index([status])
}

// SubExam model - sub-examinations per subject and term
model SubExam {
  id           String   @id @default(uuid())
  subjectId    String
  termId       String
  name         String   // "Quiz 1", "Assignment 1", "Mid Exam", "General Test"
  maxScore     Float    // e.g., 5, 10, 20, 100
  weightPercent Float   // e.g., 5%, 10%, 20%, 40%
  examType     String   // "quiz", "assignment", "mid_exam", "general_test"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  marks   Mark[]

  @@unique([subjectId, termId, name])
  @@index([subjectId])
  @@index([termId])
  @@index([subjectId, termId])
}

// Attendance model - daily attendance records
model Attendance {
  id        String           @id @default(uuid())
  studentId String
  classId   String
  date      DateTime         @db.Date
  status    AttendanceStatus
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([studentId, date])
}

// Marks model - academic marks per subject, term, student, sub-exam
model Mark {
  id         String   @id @default(uuid())
  studentId  String
  classId    String
  subjectId  String
  termId     String   // Reference to Term instead of string
  subExamId  String   // Link to SubExam
  score      Float
  maxScore   Float    // Keep for validation, but should match subExam.maxScore
  grade      String?  // Calculated grade
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  subExam SubExam @relation(fields: [subExamId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, termId, subExamId])
  @@index([studentId])
  @@index([classId])
  @@index([subjectId])
  @@index([termId])
  @@index([subExamId])
  @@index([studentId, subjectId, termId])
}

// PaymentType model - predefined payment types with fixed amounts
model PaymentType {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "Tuition Fee", "Registration Fee"
  amount      Float    // Fixed amount for this payment type
  description String?  // Optional description
  isActive    Boolean  @default(true) // Allow soft delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  payments    Payment[]

  @@index([name])
  @@index([isActive])
}

// Payment model - monthly payment records
model Payment {
  id            String         @id @default(uuid())
  studentId     String
  amount        Float
  paymentTypeId String?        // Optional to support existing payments
  month         String         // e.g., "2024-01" for January 2024
  year          Int
  status        PaymentStatus  @default(pending)
  paymentDate   DateTime?
  paymentMethod String?        // e.g., "cash", "bank_transfer", "card"
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentType PaymentType? @relation(fields: [paymentTypeId], references: [id])
  receipt     Receipt?

  @@unique([studentId, month, year])
  @@index([studentId])
  @@index([status])
  @@index([month, year])
  @@index([paymentTypeId])
}

// Receipt model - linked to confirmed payments
model Receipt {
  id          String   @id @default(uuid())
  paymentId   String   @unique
  receiptNumber String @unique
  issuedDate  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([receiptNumber])
  @@index([paymentId])
}
