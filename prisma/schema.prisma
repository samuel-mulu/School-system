generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  role           UserRole
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  teacherClasses Class[]  @relation("HeadTeacher")

  @@index([email])
  @@index([role])
}

model Student {
  id                String         @id @default(uuid())
  studentNumber     Int?           @unique
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            String
  nationality       String?
  religion          String?
  profileImageUrl   String?
  email             String?
  phone             String?
  parentName        String
  parentPhone       String
  parentEmail       String?
  parentRelation    String
  address           String
  city              String
  state             String?
  zipCode           String?
  country           String?
  emergencyName     String
  emergencyPhone    String
  emergencyRelation String
  medicalConditions String?
  allergies         String?
  bloodGroup        String?
  previousSchool    String?
  previousClass     String?
  transferReason    String?
  classStatus       ClassStatus    @default(new)
  paymentStatus     PaymentStatus  @default(pending)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  parentsPortal     Boolean        @default(true)
  attendance        Attendance[]
  marks             Mark[]
  payments          Payment[]
  classHistory      StudentClass[]

  @@index([classStatus])
  @@index([paymentStatus])
  @@index([firstName, lastName])
  @@index([studentNumber])
}

model Grade {
  id        String    @id @default(uuid())
  name      String    @unique
  order     Int       @unique
  isHighest Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  classes   Class[]
  subExams  SubExam[]
  subjects  Subject[]

  @@index([order])
  @@index([isHighest])
}

model AcademicYear {
  id        String             @id @default(uuid())
  name      String             @unique
  startDate DateTime
  endDate   DateTime?
  status    AcademicYearStatus @default(CLOSED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  classes   Class[]
  terms     Term[]

  @@index([status])
  @@index([name])
}

model SystemSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model Class {
  id             String         @id @default(uuid())
  name           String         @unique
  description    String?
  academicYearId String?
  gradeId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  headTeacherId  String?
  attendance     Attendance[]
  academicYear   AcademicYear?  @relation(fields: [academicYearId], references: [id])
  grade          Grade?         @relation(fields: [gradeId], references: [id])
  headTeacher    User?          @relation("HeadTeacher", fields: [headTeacherId], references: [id])
  marks          Mark[]
  studentClasses StudentClass[]

  @@index([name])
  @@index([academicYearId])
  @@index([gradeId])
}

model StudentClass {
  id              String           @id @default(uuid())
  studentId       String
  classId         String
  startDate       DateTime         @default(now())
  endDate         DateTime?
  reason          String
  promotionStatus PromotionStatus?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, startDate])
  @@index([studentId])
  @@index([classId])
  @@index([studentId, classId])
  @@index([promotionStatus])
}

model Teacher {
  id        String   @id @default(uuid())
  userId    String?  @unique
  name      String
  email     String?
  phone     String?
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Subject {
  id          String    @id @default(uuid())
  gradeId     String
  name        String
  code        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  marks       Mark[]
  subExams    SubExam[]
  grade       Grade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, name])
  @@index([gradeId])
}

model Term {
  id             String       @id @default(uuid())
  name           String
  academicYearId String
  startDate      DateTime     @db.Date
  endDate        DateTime?    @db.Date
  status         TermStatus   @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  marks          Mark[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([name, academicYearId])
  @@index([academicYearId])
  @@index([status])
}

model SubExam {
  id            String   @id @default(uuid())
  gradeId       String
  subjectId     String
  name          String
  maxScore      Float
  weightPercent Float
  examType      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  marks         Mark[]
  grade         Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([gradeId, subjectId, name])
  @@index([gradeId])
  @@index([subjectId])
  @@index([gradeId, subjectId])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  classId   String
  date      DateTime         @db.Date
  status    AttendanceStatus
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([studentId, date])
}

model Mark {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  subjectId String
  termId    String
  subExamId String
  score     Float
  maxScore  Float
  grade     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subExam   SubExam  @relation(fields: [subExamId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, termId, subExamId])
  @@index([studentId])
  @@index([classId])
  @@index([subjectId])
  @@index([termId])
  @@index([subExamId])
  @@index([studentId, subjectId, termId])
}

model PaymentType {
  id          String    @id @default(uuid())
  name        String    @unique
  amount      Float
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]

  @@index([name])
  @@index([isActive])
}

model Payment {
  id                String        @id @default(uuid())
  studentId         String
  amount            Float
  paymentTypeId     String?
  month             String
  year              Int
  status            PaymentStatus @default(pending)
  paymentDate       DateTime?
  paymentMethod     String?
  notes             String?
  proofImageUrl     String?
  transactionNumber String?
  receiptId         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paymentType       PaymentType?  @relation(fields: [paymentTypeId], references: [id])
  receipt           Receipt?      @relation(fields: [receiptId], references: [id])
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, month, year])
  @@index([studentId])
  @@index([status])
  @@index([month, year])
  @@index([paymentTypeId])
  @@index([receiptId])
}

model Receipt {
  id            String    @id @default(uuid())
  receiptNumber String    @unique
  issuedDate    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]

  @@index([receiptNumber])
}

enum UserRole {
  REGISTRAR
  OWNER
  TEACHER
}

enum ClassStatus {
  new
  assigned
}

enum PaymentStatus {
  pending
  confirmed
}

enum AttendanceStatus {
  present
  absent
  late
}

enum AcademicYearStatus {
  ACTIVE
  CLOSED
}

enum TermStatus {
  OPEN
  CLOSED
}

enum PromotionStatus {
  PROMOTED
  REPEATED
  GRADUATED
}
